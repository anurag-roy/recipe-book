PORT=3000
APP_BASE_URL=http://localhost:3000

# SQLite path (Bun native). The file: prefix is also accepted.
DATABASE_URL=.data/database.db

# Local demo fixtures for import + Swiggy Food/Instamart (no live credentials).
DEMO_MODE=false

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TRACING=true

# MinIO / S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=food-journal
S3_REGION=us-east-1

# Swiggy MCP + OAuth (localhost-only)
SWIGGY_MCP_FOOD_URL=https://mcp.swiggy.com/food
SWIGGY_MCP_INSTAMART_URL=https://mcp.swiggy.com/im
SWIGGY_OAUTH_AUTHORIZE_URL=https://mcp.swiggy.com/auth/authorize
SWIGGY_OAUTH_TOKEN_URL=https://mcp.swiggy.com/auth/token
SWIGGY_OAUTH_REGISTER_URL=https://mcp.swiggy.com/auth/register
SWIGGY_OAUTH_LOGOUT_URL=https://mcp.swiggy.com/auth/logout
SWIGGY_OAUTH_REDIRECT_URI=http://localhost:3000/api/swiggy/callback

# Public URL fetch limits for recipe imports
PUBLIC_URL_FETCH_TIMEOUT_MS=15000
PUBLIC_URL_FETCH_MAX_BYTES=2000000
PUBLIC_URL_FETCH_MAX_REDIRECTS=5
